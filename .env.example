# Unified Mail — environment template.
# Copy to .env.local for development. In Vercel, set these in Project Settings → Environment Variables.
# Never commit real values. Never put a secret in a NEXT_PUBLIC_* variable (the build refuses).

# --- Supabase (public: safe to expose to the browser, though this app never does) ---
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key. NOT the secret/service-role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Authorization (server-only) ---
# Comma-separated Supabase Auth user IDs allowed to use the app.
# Must match rows in app_private.authorized_users (see docs/DEPLOYMENT.md).
AUTH_ALLOWED_USER_IDS=

# --- Server database connection (server-only, required in production) ---
# Postgres URL for the least-privilege `app_worker` role, via the Supabase pooler
# (transaction mode, port 6543), e.g.
# postgresql://app_worker.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Used for audit logging now, and for encrypted credentials and sync in later phases.
DATABASE_URL=

# --- OAuth credential encryption (server-only; needed from Phase 2) ---
# Versioned AES-256 keys: "<version>:<base64 of 32 random bytes>", comma-separated for rotation.
# Generate a key with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEYS=
CREDENTIALS_ACTIVE_KEY_VERSION=

# --- Tests only (local Postgres superuser; database is dropped and recreated) ---
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unified_mail_test
# POSTGREST_BIN=/path/to/postgrest   (for npm run e2e)
