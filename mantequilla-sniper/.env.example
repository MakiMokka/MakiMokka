# --- Datos del cliente (NUNCA en el repositorio; en producción usar secretos del proveedor) ---
GUEST_FULL_NAME=
GUEST_PHONE=
GUEST_EMAIL=

# --- Operación ---
# ASSISTED: avisa con link y no envía. AUTO: envía solo si COVERMANAGER_ADAPTER_VERIFIED=true.
BOOKING_MODE=ASSISTED
COVERMANAGER_ADAPTER_VERIFIED=false
HEADLESS=true
STATE_DIR=state
PORT=8080
LOG_LEVEL=info

# --- Supabase (opcional; sin esto se usa state/store.json) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (SMTP, p. ej. smtps://usuario:clave@smtp.gmail.com:465) ---
SMTP_URL=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# --- Web Push (npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
