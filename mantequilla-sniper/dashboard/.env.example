# Supabase (solo servidor; nunca exponer la service-role key al navegador)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Contraseña de acceso al dashboard
DASHBOARD_PASSWORD=
# Web Push (misma pareja VAPID que el worker; la pública sí se expone)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Datos del cliente para mostrarlos enmascarados en Configuración (opcional)
GUEST_FULL_NAME=
GUEST_PHONE=
GUEST_EMAIL=
